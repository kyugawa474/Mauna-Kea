# Copy to .env.local (git-ignored) for local development. Never commit real values.
# For Expo Hosting, set the same names with `npx eas-cli@latest env:set` (secret visibility for the secret)
# and deploy with `npx eas-cli@latest deploy --prod --environment production`.

# Public: the app needs the client ID to open Strava's authorize page. Safe to ship.
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Server only (read by src/app/api/strava/*+api.ts). Never prefix these with EXPO_PUBLIC_.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: where the app sends token requests in a release build, e.g. https://mauna-kea.expo.app
# In development the app uses the Metro dev server, which serves the API routes itself.
EXPO_PUBLIC_API_ORIGIN=
