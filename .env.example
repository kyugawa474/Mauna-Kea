# Server-only settings for the food photo route (src/app/api/food/analyze+api.ts).
# Copy to .env.local for local development (gitignored). Never prefix these with EXPO_PUBLIC_,
# which would inline them into the app bundle.

# Anthropic API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Vision model used to estimate nutrition from a photo. Defaults to claude-sonnet-5-5.
FOOD_VISION_MODEL=claude-sonnet-5-5

# Client-side (inlined into the app): the deployed server origin the app calls in production
# builds, e.g. https://mauna-kea.expo.app. Leave blank in development (the dev server is used).
EXPO_PUBLIC_API_ORIGIN=
