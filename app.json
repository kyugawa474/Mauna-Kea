{
  "expo": {
    "name": "Mauna Kea",
    "slug": "mauna-kea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kyleyugawa.maunakea"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kyleyugawa.maunakea"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mauna Kea reads the meal photo you pick so it can estimate the food's nutrition.",
          "cameraPermission": "Mauna Kea uses the camera to photograph a meal and estimate its nutrition.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "maunakea",
    "experiments": {
      "typedRoutes": true
    }
  }
}
